# ==============================
# SERVER
# ==============================
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:3000

# ==============================
# MONGODB ATLAS
# ==============================
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/tile_showroom?retryWrites=true&w=majority

# ==============================
# JWT
# ==============================
JWT_ACCESS_SECRET=replace_with_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=replace_with_cookie_secret

# ==============================
# REDIS (caching, sessions, rate limit, refresh-token store)
# ==============================
REDIS_URL=redis://localhost:6379
REDIS_TTL_SHORT=300
REDIS_TTL_MEDIUM=1800
REDIS_TTL_LONG=86400

# ==============================
# ELASTICSEARCH (tile search/filter engine)
# ==============================
ELASTIC_NODE=http://localhost:9200
ELASTIC_USERNAME=elastic
ELASTIC_PASSWORD=changeme
ELASTIC_TILES_INDEX=tiles

# ==============================
# CLOUDINARY (image storage - tiles, layouts, previews)
# ==============================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ==============================
# INITIAL ADMIN (used by scripts/createAdmin.js)
# ==============================
INITIAL_ADMIN_NAME=Super Admin
INITIAL_ADMIN_EMAIL=admin@tileshowroom.com
INITIAL_ADMIN_PASSWORD=ChangeMe@123

# ==============================
# RATE LIMITING
# ==============================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=5
