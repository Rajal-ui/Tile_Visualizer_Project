{
  "name": "tile-visualizer",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "scripts": {
    "dev": "concurrently -k -n client,server -c blue,green \"npm run dev --workspace client\" \"npm run dev --workspace server\"",
    "dev:client": "npm run dev --workspace client",
    "dev:server": "npm run dev --workspace server",
    "build": "npm run build --workspace client",
    "build:client": "npm run build --workspace client",
    "preview": "npm run preview --workspace client",
    "start": "npm run start --workspace server",
    "test": "npm run test --workspace server",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "db:seed": "npm run seed --workspace server"
  },
  "engines": {
    "node": ">=18.11",
    "npm": ">=9"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "concurrently": "^9.1.0"
  }
}
